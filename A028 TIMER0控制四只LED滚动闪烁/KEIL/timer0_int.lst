stmt level    source

   1          /****************************************
   2          timer0_int.c:定时器0的中断程序
   3          函数：
   4          void init_timer0_int(void):定时器0的初始化函数
   5          void timer0_int(void) interrupt 1:中断处理函数
   6          ****************************************/
   7          
   8          #include "config.h"
   9          #include "intrins.h"
  10          
  11          
  12          
  13          //0.2ms定时器,累加计数200次
  14          void init_timer0_int()
  15          {
  16   1              TMOD=0x02;//1、定时器0的工作方式设置10：工作方式2，8位自动重装
  17   1              TH0=(256-200);//2、初值设置0.2ms,定时（256-200）(12M晶振，TCY=1US)
  18   1              TL0=(256-200);//定时（256-X）
  19   1              EA=1;//3、开中断
  20   1              ET0=1;//开定时器0中断
  21   1              TR0=1;//4、触发启动
  22   1      }
  23          
  24          
  25          void timer0_int() interrupt 1
  26          {
  27   1              if(++i<35) return;//中断次数进行计数，35次
  28   1              i=0;
  29   1              switch(j)
  30   1              {
  31   2                      case 0:led1=~led1;
  32   2                              break;
  33   2                      case 1:led2=~led2;
  34   2                              break;
  35   2                      case 2:led3=~led3;
  36   2                              break;
  37   2                      case 3:led4=~led4;
  38   2              }
  39   1              if(++k<200) return;     
  40   1              k=0;
  41   1              P0=0xff;//关闭LED
  42   1              j++;
  43   1              if(j>3) j=0;
  44   1      }


