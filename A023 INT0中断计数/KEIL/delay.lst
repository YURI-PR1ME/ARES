   1          /************************************************************************************************** 
   2          delay.c:延时程序,z=1，时为1ms
   3          ***************************************************************************************************/
   4          
   5          #include "config.h"
   6          
   7          /*****************************24MHZ z=1时精确延时1ms***********************************************/
   8          void delay1ms(uint16 z)
   9          {
  10   1              uch8 x,y;
  11   1              for(x=z; x>0; x--)
  12   1                      for(y=235; y>0; y--);//235
  13   1      }
  14          /***************************************************************************************************/
  15          
  16          
  17          /*---------------------------------------------------
  18           uS延时函数，含有输入参数 unsigned char t，无返回值
  19           unsigned char 是定义无符号字符变量，其值的范围是
  20           0~255 这里使用晶振12M，精确延时请使用汇编,大致延时
  21           长度如下 T=2xuS ,510us
  22          ----------------------------------------------------*/
  23          
  24          void delay2us(uch8 x)
  25          {
  26   1              while(--x);
  27   1      }


